#TALON
open user folder:
    user.open_folder("~/.talon/user")
open chickens folder:
    user.open_folder("~/.talon/user/chickens-talon")
open chickens apps:
    user.open_folder("~/.talon/user/chickens-talon/applications")

#GENERAL FOLDERS
open documents:
    user.open_folder("~/Documents")
open downloads:
    user.open_folder("~/Downloads")
open apps:
    user.open_folder("~/Applications")
