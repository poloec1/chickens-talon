# Left button
key(f13:down):              user.foot_switch_down_event(0)
key(f13:up):                user.foot_switch_up_event(0)

# Right button
key(f17:down):              user.foot_switch_down_event(2)
key(f17:up):                user.foot_switch_up_event(2)

# Top button
key(f4:down):              user.foot_switch_down_event(3)
key(f4:up):                user.foot_switch_up_event(3)

# Center button
key(f5:down):              user.foot_switch_down_event(1)
key(f5:up):                user.foot_switch_up_event(1)
