os: mac
app: CapCut
-
cut: key(cmd-b)
delete right: key(w)
delete left: key(q)
select: key(a)
hide: key(v)
group: key(cmd-g)
compound: key(alt-g)
split compound: key(alt-shift-g)
ungroup: key(cmd-shift-g)
extract audio: key(ctrl-shift-s)
split all: key(cmd-shift-b)
keyframe: key(cmd-shift-k)
new note: key(cmd-n)
reverse: key(cmd-shift-r)
mirror: key(cmd-shift-m)
rotate: key(shift-ctrl-r)
generate captions: key(shift-ctrl-c)
Full screen: key(cmd-shift-f)
magnet: key(p)
play video:key(space)
pause video:key(space)
marker: key(m)
copy attributes: key(cmd-shift-c)
paste attributes: key(cmd-shift-v)
freeze: key(ctrl-shift-r)
record audio: key(cmd-ctrl-v)
view timeline: key(shift-z)

no volume: 
	mouse_move(1398.8409423828125, 79.99555969238281)
	sleep(200ms)
	mouse_click(0)
	mouse_move(1327.4486083984375, 228.23849487304688)
	sleep(200ms)
	mouse_click(0)
fadein: 
	mouse_move(1398.8409423828125, 79.99555969238281)
	sleep(200ms)
	mouse_click(0)
	mouse_move(1822.0, 275.0)
	sleep(200ms)
	mouse_click(0)
	sleep(300ms)
	key(cmd-a)
	key(delete)
fade out: 
	mouse_move(1398.8409423828125, 79.99555969238281)
	sleep(200ms)
	mouse_click(0)
	mouse_move(1823.0, 314.0)
	sleep(200ms)
	mouse_click(0)
	sleep(200ms)
	key(cmd-a)
	key(delete)
animation duration:
	mouse_move(1396.0, 83.0)
	sleep(200ms)
	mouse_click(0)
	mouse_move(1401.0, 464.0)
	sleep(200ms)
	mouse_click(0)
	sleep(300ms)
	key(cmd-a)
	key(delete)
